# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=black_owned
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/black_owned

# Valkey/Redis Configuration
VALKEY_HOST=localhost
VALKEY_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production

# Session Cookie keys (LOC-0092) -- RSA PEM pair for the bw-session token.
# Edge middleware reads these from the environment ONLY: there is no
# config/jwt/*.pem fallback on the Edge runtime (survey anti-pattern #12).
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# VALUES MUST BE QUOTED: @next/env truncates an unquoted value at the first
# \n, silently yielding a header-only key (every login 500s, every /admin
# redirects). Proven against @next/env in a clean subprocess, 2026-09-18.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...paste PKCS8 pem, one \n between each line...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...paste SPKI pem, one \n between each line...\n-----END PUBLIC KEY-----"

# Scraper Worker Configuration
# Base URL of the bw-scraper worker (enrichment + scrape endpoints)
SCRAPER_BASE_URL=http://localhost:8080
